<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/install_phase"
            style="@style/LauncherHeading"
            android:layout_width="0dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/install_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#9CB4FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/install_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progressBackgroundTint="#263755"
        android:progressTint="#5280FF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/install_time"
        style="@style/LauncherCaption"
        android:layout_marginTop="7dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/launcher_install_log"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/LauncherHeading"
            android:text="@string/install_log_title"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/install_log"
            style="@style/LauncherCaption"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</merge>

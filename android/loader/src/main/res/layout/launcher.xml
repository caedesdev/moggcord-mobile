<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="26dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="66dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/moggcord_icon" />

        <TextView
            style="@style/LauncherHeading"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textSize="29sp" />

        <TextView
            style="@style/LauncherCaption"
            android:layout_marginBottom="12dp"
            android:text="@string/launcher_description" />

        <LinearLayout style="@style/LauncherCard">
            <TextView style="@style/LauncherHeading" android:text="@string/discord" />
            <TextView android:id="@+id/discord_status" style="@style/LauncherCaption" />
            <Button android:id="@+id/discord_action" style="@style/LauncherButton" />
        </LinearLayout>

        <LinearLayout style="@style/LauncherCard">
            <TextView style="@style/LauncherHeading" android:text="@string/setup_title" />
            <TextView style="@style/LauncherCaption" android:text="@string/setup_description" />
            <Button android:id="@+id/setup_action" style="@style/LauncherButton" android:text="@string/setup_action" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/previous_loader"
            style="@style/LauncherCard"
            android:visibility="gone">
            <TextView style="@style/LauncherHeading" android:text="@string/previous_loader" />
            <TextView style="@style/LauncherCaption" android:text="@string/previous_loader_description" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

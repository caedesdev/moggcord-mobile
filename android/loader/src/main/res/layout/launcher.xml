<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="26dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="66dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/moggcord_icon" />

        <TextView
            style="@style/LauncherHeading"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textSize="29sp" />

        <TextView
            style="@style/LauncherCaption"
            android:layout_marginBottom="12dp"
            android:text="@string/launcher_description" />

        <LinearLayout style="@style/LauncherCard">
            <TextView style="@style/LauncherHeading" android:text="@string/discord" />
            <TextView android:id="@+id/discord_status" style="@style/LauncherCaption" />
            <Button
                android:id="@+id/open_moggcord"
                style="@style/LauncherButton"
                android:text="@string/open_moggcord"
                android:visibility="gone" />
            <Button android:id="@+id/discord_action" style="@style/LauncherButton" />
            <ProgressBar
                android:id="@+id/install_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />
            <TextView
                android:id="@+id/install_status"
                style="@style/LauncherCaption"
                android:accessibilityLiveRegion="polite"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MoggcordLauncherTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#0A1020</item>
        <item name="android:statusBarColor">#0A1020</item>
        <item name="android:navigationBarColor">#0A1020</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#A9BEFF</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
    </style>
    <style name="LauncherCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/launcher_card</item>
    </style>
    <style name="LauncherHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#F3F6FF</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="LauncherCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#B4C0DA</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="LauncherButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/launcher_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F7F9FF</item>
    </style>
</resources>
